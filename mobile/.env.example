# Copie este arquivo para .env e preencha com valores reais locais.
# Nenhuma credencial ou segredo deve viver aqui — variáveis EXPO_PUBLIC_* são
# expostas no bundle do app, então são inerentemente públicas.

# URL base da API. Em device físico, "localhost" não alcança a máquina host,
# então aponte para o IP da máquina na rede local, ex: http://192.168.0.10:9000
EXPO_PUBLIC_API_URL=
